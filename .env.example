# Existing optional legacy Teacher configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TEACHER_FUNCTION=teacher-plan
DAVID_USER_EMAIL=
DAVID_USER_PASSWORD=

# DAVID Electron GPT Teacher Loop
DAVID_TEACHER_CHAT_URL=https://chatgpt.com/c/6a6d7e46-3534-83eb-a42b-c981bad99c84
DAVID_REPOSITORY_ROOT=E:\\david-cursor-v1-complete\\david-cursor-v1
DAVID_MAX_TEACHER_ROUNDS=8
DAVID_GPT_RESPONSE_TIMEOUT_MS=240000
DAVID_POWERSHELL_TIMEOUT_MS=600000
DAVID_MAX_TEACHER_OUTPUT_CHARS=30000
DAVID_POWERSHELL_EXE=powershell.exe

# false = DAVID asks before scripts that change files.
# true = medium-risk changes inside the DAVID repository may run automatically.
DAVID_AUTO_APPROVE_SAFE_POWERSHELL=false

# Existing paired DAVID device token.
# Use the same local token already paired in david_device_credentials.
# Keep it only in the local .env file. Never commit or paste it into chat.
DAVID_DEVICE_BRIDGE_FUNCTION=david-soul-bridge
DAVID_DEVICE_TOKEN=

# DAVID Electron inside Soul Free / Fast Brain
# Use the real private ChatGPT conversation URL, not a /share/ link.
DAVID_SOUL_CHAT_URL=https://chatgpt.com/c/PASTE-SOUL-CHAT-ID
# Locked to the authenticated Twins owner account: Dimitar Lambov.
DAVID_SOUL_USER_ID=de35fedf-f922-42b2-bf14-9320c11fb2a4
DAVID_SOUL_POLL_MS=2500
DAVID_SOUL_RESPONSE_TIMEOUT_MS=240000
DAVID_SOUL_MAX_MESSAGE_CHARS=20000
# Keep true for the first login. It may be false after persist:david-soul is authenticated.
DAVID_SOUL_BROWSER_VISIBLE=true

# Existing native Smart Cursor fallback controls
DAVID_ENABLE_NATIVE_ACTIONS=false
DAVID_MAX_TRAINING_ATTEMPTS=3
